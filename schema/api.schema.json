{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ThePhaseless/pagewire/main/schema/api.schema.json",
  "$defs": {
    "AdvertisedService": {
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "name",
        "port"
      ]
    },
    "BlobStatus": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "installed",
            "missing",
            "failed",
            "disabled"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "version",
        "state",
        "message"
      ]
    },
    "Config": {
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "pagewire/v2"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[^\\-\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
          "description": "Required, 1 to 63 characters, no control characters, not starting with -. The UI title."
        },
        "printers": {
          "items": {
            "$ref": "#/$defs/Printer"
          },
          "type": "array",
          "description": "Printers pagewire serves (default [])."
        },
        "scanners": {
          "items": {
            "$ref": "#/$defs/Scanner"
          },
          "type": "array",
          "description": "Scanners pagewire serves (default [])."
        },
        "ignoredDevices": {
          "items": {
            "$ref": "#/$defs/IgnoredDevice"
          },
          "type": "array",
          "description": "USB devices the setup wizard does not offer again (default [])."
        },
        "print": {
          "$ref": "#/$defs/PrintConfig"
        },
        "scan": {
          "$ref": "#/$defs/ScanConfig"
        },
        "licenses": {
          "$ref": "#/$defs/Licenses"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "apiVersion",
        "name",
        "printers",
        "scanners",
        "ignoredDevices",
        "print",
        "scan",
        "licenses"
      ]
    },
    "ConfigEvent": {
      "properties": {
        "etag": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "etag"
      ]
    },
    "ConfigResponse": {
      "properties": {
        "etag": {
          "type": "string"
        },
        "config": {
          "oneOf": [
            {
              "$ref": "#/$defs/Config"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "applied",
            "invalid"
          ]
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/FieldError"
          },
          "type": "array"
        },
        "lastGood": {
          "oneOf": [
            {
              "$ref": "#/$defs/Config"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "etag",
        "config",
        "state",
        "errors",
        "lastGood"
      ]
    },
    "DetectedDevice": {
      "properties": {
        "device": {
          "$ref": "#/$defs/USBDevice"
        },
        "node": {
          "type": "string"
        },
        "canPrint": {
          "type": "boolean"
        },
        "canScan": {
          "type": "boolean"
        },
        "printerId": {
          "type": "string"
        },
        "scannerId": {
          "type": "string"
        },
        "ignored": {
          "items": {
            "type": "string",
            "enum": [
              "printer",
              "scanner"
            ]
          },
          "type": "array"
        },
        "suggestedPrinter": {
          "oneOf": [
            {
              "$ref": "#/$defs/Printer"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggestedScanner": {
          "oneOf": [
            {
              "$ref": "#/$defs/Scanner"
            },
            {
              "type": "null"
            }
          ]
        },
        "printerDecision": {
          "oneOf": [
            {
              "$ref": "#/$defs/PrinterDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "scannerDecision": {
          "oneOf": [
            {
              "$ref": "#/$defs/ScannerDecision"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "device",
        "node",
        "canPrint",
        "canScan",
        "printerId",
        "scannerId",
        "ignored",
        "suggestedPrinter",
        "suggestedScanner",
        "printerDecision",
        "scannerDecision"
      ]
    },
    "EULA": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "available",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        },
        "textSha256": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "vendor",
        "summary",
        "state",
        "message",
        "textSha256",
        "text"
      ]
    },
    "EULARef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "textSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex sha256 of the accepted licence text. Settings writes it when you accept; required in acceptedEulas."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "version"
      ]
    },
    "FieldError": {
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "line",
        "column",
        "message"
      ]
    },
    "FormatConversion": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to"
      ]
    },
    "IgnoredDevice": {
      "properties": {
        "vendorId": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}$"
        },
        "serial": {
          "type": "string",
          "maxLength": 126,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "description": "USB serial number, at most 126 characters, no control characters."
        },
        "roles": {
          "items": {
            "type": "string",
            "enum": [
              "printer",
              "scanner"
            ]
          },
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "printer, scanner or both."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "vendorId",
        "productId",
        "serial",
        "roles"
      ]
    },
    "Job": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "printer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "processing",
            "completed",
            "canceled",
            "aborted",
            "held",
            "stopped"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "printer",
        "name",
        "state",
        "reasons",
        "createdAt"
      ]
    },
    "Licenses": {
      "properties": {
        "acceptedEulas": {
          "items": {
            "$ref": "#/$defs/EULARef"
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Each {id, version} must exist in the catalog and appear once; textSha256 is required."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "acceptedEulas"
      ]
    },
    "Marker": {
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "color",
        "level"
      ]
    },
    "PrintConfig": {
      "properties": {
        "maxUploadMiB": {
          "type": "integer",
          "maximum": 500,
          "minimum": 1,
          "default": 50
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "maxUploadMiB"
      ]
    },
    "PrintDefaults": {
      "properties": {
        "media": {
          "type": "string",
          "pattern": "^[a-z0-9-]+_[a-z0-9.-]+_[0-9.]+x[0-9.]+(mm|in)$",
          "description": "PWG self-describing media name, such as iso_a4_210x297mm."
        },
        "mediaSource": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$",
          "description": "Tray keyword the printer reports, such as auto, main, tray-1 or manual."
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$",
          "description": "Media type keyword the printer reports, such as stationery or photographic-glossy."
        },
        "sides": {
          "type": "string",
          "enum": [
            "one-sided",
            "two-sided-long-edge",
            "two-sided-short-edge"
          ]
        },
        "colorMode": {
          "type": "string",
          "enum": [
            "auto",
            "color",
            "monochrome"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "draft",
            "normal",
            "high"
          ]
        },
        "resolution": {
          "type": "integer",
          "maximum": 2400,
          "minimum": 75,
          "description": "Dots per inch."
        },
        "contentOptimize": {
          "type": "string",
          "enum": [
            "auto",
            "graphic",
            "photo",
            "text",
            "text-and-graphic"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "reverse-landscape",
            "reverse-portrait"
          ]
        },
        "numberUp": {
          "type": "integer",
          "maximum": 16,
          "minimum": 1,
          "description": "Pages per sheet."
        },
        "printScaling": {
          "type": "string",
          "enum": [
            "auto",
            "auto-fit",
            "fill",
            "fit",
            "none"
          ]
        },
        "outputBin": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$",
          "description": "Output bin keyword the printer reports, such as face-down or top."
        },
        "finishings": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$",
          "description": "One IANA finishings keyword, such as none, staple or punch."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PrintOptions": {
      "properties": {
        "copies": {
          "type": "integer",
          "maximum": 99,
          "minimum": 0
        },
        "media": {
          "type": "string",
          "pattern": "^[a-z0-9-]+_[a-z0-9.-]+_[0-9.]+x[0-9.]+(mm|in)$"
        },
        "mediaSource": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
        },
        "sides": {
          "type": "string",
          "enum": [
            "one-sided",
            "two-sided-long-edge",
            "two-sided-short-edge"
          ]
        },
        "colorMode": {
          "type": "string",
          "enum": [
            "auto",
            "color",
            "monochrome"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "draft",
            "normal",
            "high"
          ]
        },
        "resolution": {
          "type": "integer",
          "maximum": 2400,
          "minimum": 75
        },
        "contentOptimize": {
          "type": "string",
          "enum": [
            "auto",
            "graphic",
            "photo",
            "text",
            "text-and-graphic"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "reverse-landscape",
            "reverse-portrait"
          ]
        },
        "numberUp": {
          "type": "integer",
          "maximum": 16,
          "minimum": 1
        },
        "printScaling": {
          "type": "string",
          "enum": [
            "auto",
            "auto-fit",
            "fill",
            "fit",
            "none"
          ]
        },
        "outputBin": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
        },
        "finishings": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "PrintResult": {
      "properties": {
        "job": {
          "$ref": "#/$defs/Job"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "job",
        "warnings"
      ]
    },
    "Printer": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
          "description": "Required, 1 to 32 lower-case letters, digits or dashes, not starting or ending with a dash. Unique across printers and scanners."
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[^\\-\\x00-\\x1f\\x7f-\\x9f][^\\x00-\\x1f\\x7f-\\x9f]*$",
          "description": "Required, 1 to 63 characters, no control characters, not starting with -, unique among printers (ignoring case). The queue and DNS-SD name of PAPPL and simulated printers; ipp-usb and AirSane advertise the device's own names."
        },
        "location": {
          "type": "string",
          "maxLength": 127,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "description": "printer-location, 0 to 127 characters."
        },
        "enabled": {
          "type": "boolean",
          "description": "false keeps the entry but does not serve the printer (default true).",
          "default": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "usb",
            "simulated"
          ],
          "description": "usb, or simulated (a test printer, no USB resource).",
          "default": "usb"
        },
        "usb": {
          "$ref": "#/$defs/USB",
          "description": "Selects the USB device. Only allowed with mode usb; at most one usb printer may leave it out."
        },
        "driver": {
          "type": "string",
          "enum": [
            "auto",
            "ipp-usb",
            "ps",
            "hplip",
            "gutenprint",
            "ghostscript",
            "legacy"
          ],
          "default": "auto"
        },
        "driverName": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "description": "Optional exact driver name from the printer application, at most 255 characters. With driver auto, the first family that lists it runs; with a family, that family's driver of that name runs. A name that is not listed leaves pagewire's own choice running (within the family, when driver names one) and the printer degraded. Not allowed with driver ipp-usb or mode simulated."
        },
        "defaults": {
          "$ref": "#/$defs/PrintDefaults"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "location",
        "enabled",
        "mode",
        "driver",
        "defaults"
      ]
    },
    "PrinterCaps": {
      "properties": {
        "media": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mediaSources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mediaTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sides": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "colorModes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "qualities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contentOptimize": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "orientations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "printScalings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outputBins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finishings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "formats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolutions": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "numberUp": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "copiesMax": {
          "type": "integer"
        },
        "mediaDefault": {
          "type": "string"
        },
        "mediaSourceDefault": {
          "type": "string"
        },
        "mediaTypeDefault": {
          "type": "string"
        },
        "sidesDefault": {
          "type": "string"
        },
        "colorModeDefault": {
          "type": "string"
        },
        "qualityDefault": {
          "type": "string"
        },
        "contentOptimizeDefault": {
          "type": "string"
        },
        "orientationDefault": {
          "type": "string"
        },
        "printScalingDefault": {
          "type": "string"
        },
        "outputBinDefault": {
          "type": "string"
        },
        "finishingsDefault": {
          "type": "string"
        },
        "resolutionDefault": {
          "type": "integer"
        },
        "numberUpDefault": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "media",
        "mediaSources",
        "mediaTypes",
        "sides",
        "colorModes",
        "qualities",
        "contentOptimize",
        "orientations",
        "printScalings",
        "outputBins",
        "finishings",
        "formats",
        "resolutions",
        "numberUp",
        "copiesMax",
        "mediaDefault",
        "mediaSourceDefault",
        "mediaTypeDefault",
        "sidesDefault",
        "colorModeDefault",
        "qualityDefault",
        "contentOptimizeDefault",
        "orientationDefault",
        "printScalingDefault",
        "outputBinDefault",
        "finishingsDefault",
        "resolutionDefault",
        "numberUpDefault"
      ]
    },
    "PrinterConnect": {
      "properties": {
        "dnssdName": {
          "type": "string"
        },
        "ippUris": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "dnssdName",
        "ippUris"
      ]
    },
    "PrinterDecision": {
      "properties": {
        "family": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        },
        "driverDescription": {
          "type": "string"
        },
        "requiredEulas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "optionalEulas": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule": {
          "type": "string",
          "enum": [
            "ipp-over-usb",
            "model",
            "command-set",
            "override",
            "none",
            "simulated"
          ]
        },
        "device": {
          "oneOf": [
            {
              "$ref": "#/$defs/USBDevice"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "family",
        "driver",
        "driverDescription",
        "requiredEulas",
        "optionalEulas",
        "rule",
        "device"
      ]
    },
    "Problem": {
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "detail": {
          "type": "string"
