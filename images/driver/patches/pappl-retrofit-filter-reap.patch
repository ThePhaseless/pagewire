+// Serializes the walks over the spooling conversions (pagewire patch)
+static pthread_mutex_t conversions_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+
+//
+// '_prFilterChainAndReap()' - Run cfFilterChain() and wait until every
+//                             process it started has ended (pagewire
+//                             patch).
+//
+//                             A filter function, called in a child process
+//                             of its own (see _prFilterChain()). As child
+//                             subreaper it also adopts the processes the
+//                             filters leave behind, such as the CUPS
+//                             backend the "Backend" filter starts, and
+//                             reaps them; otherwise they would end up as
+//                             zombies of the printer application, which is
+//                             PID 1 in its container and never reaps them.
+//
+
+int					// O - cfFilterChain()'s result
+_prFilterChainAndReap(int inputfd,	// I - File descriptor input stream
+		      int outputfd,	// I - File descriptor output stream
+		      int inputseekable,// I - Is input stream seekable?
+		      cf_filter_data_t *data,// I - Job and printer data
+		      void *parameters)	// I - Filter chain
+{
+  int	ret;				// cfFilterChain()'s result
+
+
+  prctl(PR_SET_CHILD_SUBREAPER, 1);
+  ret = cfFilterChain(inputfd, outputfd, inputseekable, data, parameters);
+  // When a pipe() fails, cfFilterChain() returns with the pipes to the filters
+  // it started still open; closed, a filter writing to them gets EPIPE
+  // instead of blocking this wait for good
+  closefrom(3);
+  while (wait(NULL) > 0 || errno == EINTR);
+
+  return (ret);
+}
+
+
+//
+// '_prFilterChain()' - Run a filter chain in a child process of its own
+//                      (pagewire patch).
+//
+//                      cfFilterChain() waits for its filters with wait(),
+//                      which reaps any child of the process. Called from
+//                      two job threads at once, each reaps the other's
+//                      filters and both loop on ECHILD forever. In a
+//                      child process the filters are its children only,
+//                      so no other thread reaps them and its wait() sees
+//                      no other thread's children.
+//
+
+int					// O - cfFilterChain()'s result, 1 on error
+_prFilterChain(int inputfd,		// I - File descriptor input stream
+	       int outputfd,		// I - File descriptor output stream
+	       int inputseekable,	// I - Is input stream seekable?
+	       cf_filter_data_t *data,	// I - Job and printer data
+	       cups_array_t *chain)	// I - Filter chain
+{
+  pid_t	pid;				// Process ID of the chain
+  int	status;				// Its exit status
+
+
+  if ((pid = fork()) == 0)
+    _exit(_prFilterChainAndReap(inputfd, outputfd, inputseekable, data, chain));
+
+  if (pid < 0)
+  {
+    if (data->logfunc)
+      data->logfunc(data->logdata, CF_LOGLEVEL_ERROR,
+		    "_prFilterChain: Could not fork: %s", strerror(errno));
+    return (1);
+  }
+
+  while (waitpid(pid, &status, 0) < 0)
+    if (errno != EINTR)
+    {
+      if (data->logfunc)
+	data->logfunc(data->logdata, CF_LOGLEVEL_ERROR,
+		      "_prFilterChain: Lost filter chain (PID %d): %s",
+		      (int)pid, strerror(errno));
+      return (1);
+    }
+
+  if (WIFEXITED(status))
+    return (WEXITSTATUS(status));
+
+  if (data->logfunc)
+    data->logfunc(data->logdata, CF_LOGLEVEL_ERROR,
+		  "_prFilterChain: Filter chain (PID %d) crashed on signal %d",
+		  (int)pid, WTERMSIG(status));
+  return (1);
+}
+
