diff --git a/pappl/client-webif.c b/pappl/client-webif.c
index 48714be..7b8590e 100644
--- a/pappl/client-webif.c
+++ b/pappl/client-webif.c
@@ -449,12 +449,16 @@ papplClientHTMLAuthorize(
   const char	*status = NULL;		// Status message, if any
 
 
-  // Don't authorize if we have no auth service or we don't have a password set.
-  if (!client || (!client->system->auth_service && !client->system->auth_cb && !client->system->password_hash[0]))
+  if (!client)
+    return (false);
+
+  // pagewire: with no auth service or callback, refuse every client; the
+  // access password is ignored, so one set before this patch cannot log in.
+  if (!client->system->auth_service && !client->system->auth_cb)
   {
-    _PAPPL_DEBUG("papplClientHTMLAuthorize: auth_service='%s', auth_cb=%s, password_hash=%s\n", client->system->auth_service, client->system->auth_cb != NULL ? "set" : "unset", client->system->password_hash[0] ? "set" : "unset");
-    _PAPPL_DEBUG("papplClientHTMLAuthorize: Returning true.");
-    return (true);
+    _PAPPL_DEBUG("papplClientHTMLAuthorize: no auth service, returning false.\n");
+    papplClientRespond(client, HTTP_STATUS_FORBIDDEN, NULL, NULL, 0, 0);
+    return (false);
   }
 
   // When using an auth service, use HTTP Basic authentication...
diff --git a/pappl/printer-webif.c b/pappl/printer-webif.c
index 2047a16..571bd2c 100644
--- a/pappl/printer-webif.c
+++ b/pappl/printer-webif.c
@@ -785,6 +785,10 @@ _papplPrinterWebHome(
     cups_option_t	*form = NULL;	// Form variables
     const char		*action;	// Form action
 
+    // pagewire: these actions change the printer, so they need authorization.
+    if (!papplClientHTMLAuthorize(client))
+      return;
+
     if ((num_form = (cups_len_t)papplClientGetForm(client, &form)) == 0)
     {
       status = _PAPPL_LOC("Invalid form data.");
