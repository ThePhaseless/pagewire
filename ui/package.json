  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "happy-dom": "21.0.4",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
